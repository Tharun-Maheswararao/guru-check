# Copy to .env and fill in. Never commit .env: a key pushed to GitHub gets every key on the
# hackathon account shut down, and deleting it in a later commit isn't enough.
#
# Each teammate uses the key from their own temporary account: aistudio.google.com/api-keys
# One key works for every DeepMind model (Hydrogen, Decisions, Neon, Carbon, image generation).
GEMINI_API_KEY=

# Optional: a different key or endpoint for one model. Leave blank to use GEMINI_API_KEY.
HYDROGEN_API_KEY=
HYDROGEN_MODEL=gemini-4-hydrogen
DECISIONS_API_KEY=
DECISIONS_MODEL=gemini-decision-1

# Where price files, runs, logs and NPC records are stored locally (gitignored)
DATA_DIR=data

# Tuning (optional)
SCAN_THRESHOLD=0.5
MATCH_THRESHOLD=0.9
